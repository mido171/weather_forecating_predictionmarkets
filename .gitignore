.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Raw and derived data are deliberately excluded from Git.
data/raw/**
data/bronze/**
data/silver/**
data/gold/**
data/cache/**
!data/raw/.gitkeep
!data/bronze/.gitkeep
!data/silver/.gitkeep
!data/gold/.gitkeep
!data/cache/.gitkeep
!data/raw/**/
!data/bronze/**/
!data/silver/**/
!data/gold/**/
!data/cache/**/
!data/**/README.md

# Experiment payloads may be large; documentation and small metrics stay versioned.
experiments/**/artifacts/*
experiments/**/logs/*
experiments/**/results/*.parquet
experiments/**/results/*.feather
experiments/**/results/*.nc
experiments/**/results/*.zarr/
!experiments/**/artifacts/.gitkeep
!experiments/**/logs/.gitkeep

reports/generated/
tmp/
.DS_Store
