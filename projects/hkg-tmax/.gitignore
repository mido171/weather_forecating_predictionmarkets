.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
apps/**/dist/
apps/**/node_modules/
*.egg-info/

# Raw and derived data are deliberately excluded from Git.
data/raw/**
data/bronze/**
data/silver/**
data/gold/**
data/cache/**
!data/raw/.gitkeep
!data/bronze/.gitkeep
!data/silver/.gitkeep
!data/gold/.gitkeep
!data/cache/.gitkeep
!data/raw/**/
!data/bronze/**/
!data/silver/**/
!data/gold/**/
!data/cache/**/
!data/**/README.md

# Large Info.gov hourly-reading backfill payloads.
data/datasets/13_hko_info_gov_hourly_readings/raw_html/**
data/datasets/13_hko_info_gov_hourly_readings/metadata/**
data/datasets/13_hko_info_gov_hourly_readings/normalized/**
data/datasets/13_hko_info_gov_hourly_readings/reports/**
!data/datasets/13_hko_info_gov_hourly_readings/
!data/datasets/13_hko_info_gov_hourly_readings/README.md

# Experiment payloads may be large; documentation and small metrics stay versioned.
experiments/**/artifacts/*
experiments/**/logs/*
experiments/**/results/*.parquet
experiments/**/results/*.feather
experiments/**/results/*.nc
experiments/**/results/*.zarr/
!experiments/**/artifacts/.gitkeep
!experiments/**/logs/.gitkeep

reports/generated/
tmp/
.DS_Store

# Local credentials. Keep token values out of Git, docs, logs, and artifacts.
secrets/local/*
!secrets/local/README.md
