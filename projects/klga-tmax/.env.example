# Copy to .env or export through your shell. Never commit real values.
KLGA_ENV=local
KLGA_TRADING_MODE=backtest
KLGA_ENABLE_LIVE=
KLGA_DB_URL=
KLGA_RUN_ROOT=C:/klga_tmax_data/runs
KLGA_ARTIFACT_ROOT=C:/klga_tmax_data/runs/artifacts
KLGA_N_JOBS=1
KLGA_LOG_LEVEL=INFO
GRIBSTREAM_API_TOKEN=
GRIBSTREAM_API_TOKEN_FILE=
GRIBSTREAM_SPACING_SECONDS=12
GRIBSTREAM_MAX_RETRIES=2
WUNDERGROUND_API_KEY=
WUNDERGROUND_MAX_WORKERS=1
WUNDERGROUND_CHUNK_DAYS=7
WUNDERGROUND_API_RATE_LIMIT_PER_MINUTE=30
WUNDERGROUND_API_MAX_RETRIES=2
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
