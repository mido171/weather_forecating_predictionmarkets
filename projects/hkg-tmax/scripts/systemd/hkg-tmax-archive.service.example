[Unit]
Description=HKG Tmax append-only live archive
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/ABSOLUTE/PATH/hkg_tmax_elite_codex
EnvironmentFile=/ABSOLUTE/PATH/hkg_tmax_elite_codex/.env
ExecStart=/ABSOLUTE/PATH/hkg_tmax_elite_codex/.venv/bin/python -m hkg_tmax sources fetch --tag bootstrap_now --continue-on-error
User=REPLACE_ME
Group=REPLACE_ME
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/ABSOLUTE/PATH/hkg_tmax_elite_codex/data/raw
