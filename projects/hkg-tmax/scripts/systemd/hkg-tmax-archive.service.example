[Unit]
Description=HKG Tmax append-only live archive
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/ABSOLUTE/PATH/weather_data_extraction/projects/hkg-tmax
EnvironmentFile=/ABSOLUTE/PATH/weather_data_extraction/projects/hkg-tmax/.env
# Intentionally remains dry-run until an operator adds --execute after approving a bounded budget.
ExecStart=/ABSOLUTE/PATH/weather_data_extraction/projects/hkg-tmax/.venv/bin/python -m hkg_tmax sources fetch --tag scheduled_archive --max-sources 1 --continue-on-error
User=REPLACE_ME
Group=REPLACE_ME
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/ABSOLUTE/PATH/TO/HKG_TMAX_DATA_ROOT/raw /ABSOLUTE/PATH/TO/HKG_TMAX_RUN_ROOT
