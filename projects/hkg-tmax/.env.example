# Copy this file to .env. Never commit secrets.

# Optional authenticated providers. Public HKO and Polymarket reads do not normally require these.
ECMWF_API_KEY=
GRIBSTREAM_API_KEY=
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Runtime
HKG_TMAX_ROOT=.
HKG_TMAX_DATA_ROOT=C:/hkg_tmax_data
HKG_TMAX_RUN_ROOT=C:/hkg_tmax_data/runs
HKG_TMAX_INPUT_ROOT=C:/hkg_tmax_data/runs/inputs
HKG_T24_BEASTMODE_ROADMAP_PATH=
HKG_T24_GPT_PRO_POINT_FORECAST_SPEC_PATH=
HKG_T24_LONG_HISTORY_SPEC_PATH=
HKG_TMAX_STORAGE_ROOT_ID=hkg-tmax-data
HKG_TMAX_USER_AGENT=HKG-Tmax-Research/0.1 (+research-contact-required)
HKG_TMAX_HTTP_TIMEOUT_SECONDS=60
HKG_TMAX_MIN_REQUEST_INTERVAL_SECONDS=1.0
HKG_TMAX_ENABLE_COLLECTORS=0
HKG_TMAX_COLLECTOR_MAX_SOURCES=1
HKG_TMAX_COLLECTOR_MAX_REQUESTS=1
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1

# Database ingestion. Placeholder only; never commit a real production URL.
HKG_TMAX_DATABASE_URL=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=hkg_tmax_research
MYSQL_PORT=3306
POSTGRES_USER=hkg_tmax_ingest
POSTGRES_PASSWORD=
POSTGRES_DB=hkg_tmax_research
POSTGRES_PORT=5432
