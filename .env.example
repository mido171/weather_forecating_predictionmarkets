# Copy this file to .env. Never commit secrets.

# Optional authenticated providers. Public HKO and Polymarket reads do not normally require these.
ECMWF_API_KEY=
GRIBSTREAM_API_KEY=
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Runtime
HKG_TMAX_ROOT=.
HKG_TMAX_DATA_ROOT=C:\hkg_tmax_data
HKG_TMAX_USER_AGENT=HKG-Tmax-Research/0.1 (+research-contact-required)
HKG_TMAX_HTTP_TIMEOUT_SECONDS=60
HKG_TMAX_MIN_REQUEST_INTERVAL_SECONDS=1.0

# Database ingestion. Placeholder only; never commit a real production URL.
HKG_TMAX_DATABASE_URL=postgresql://hkg_tmax_ingest:change-me@127.0.0.1:5432/hkg_tmax_research
