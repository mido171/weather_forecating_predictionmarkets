# Local environment and credentials
.env
.env.local
secrets/local/*
!secrets/local/README.md

# Python/tool state
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# UI dependencies/builds
apps/**/dist/
apps/**/node_modules/

# Runtime roots. Canonical data/runs are external; these patterns prevent a
# legacy script from polluting the project if it writes to an old local path.
/data/
/var/
/analysis/
/reports/
/research/
/artifacts/
/models/
/predictions/
/run_logs/
/handoffs/
/tmp/

# Large experiment payloads. Compact manifests, protocols, metrics, and
# conclusions remain trackable.
experiments/**/artifacts/
experiments/**/logs/
experiments/**/*.parquet
experiments/**/*.feather
experiments/**/*.arrow
experiments/**/*.nc
experiments/**/*.zarr/
experiments/**/*.joblib
experiments/**/*.pkl
experiments/**/*.onnx

# Local/editor/packaging debris
.DS_Store
Thumbs.db
*.zip
*.rar
*.7z
*.log
